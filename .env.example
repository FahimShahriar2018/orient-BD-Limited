SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,orient-bd.onrender.com
DATABASE_URL=postgres://user:password@hostname:5432/dbname
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://orient-bd.onrender.com,http://localhost:8000

# Email Settings (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourgmailaddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Orient Computers <yourgmailaddress@gmail.com>
